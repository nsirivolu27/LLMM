{
  "name": "llmm-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:web": "vite build",
    "build": "npm run build:web && corepack pnpm --dir relay run build",
    "preview": "vite preview",
    "start": "corepack pnpm --dir relay run start",
    "infra:synth": "infra/node_modules/.bin/cdk synth",
    "infra:diff": "infra/node_modules/.bin/cdk diff",
    "test": "corepack pnpm --dir relay test",
    "typecheck": "tsc --noEmit && corepack pnpm --dir relay run typecheck"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.8.0",
    "vite": "^5.4.11"
  }
}
